{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-typescript",
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "plugins": [
    "i18next-extract",
    [
      "module-resolver",
      {
        "root": ["./src"],
        "alias": {
          "entities": "./src/entities"
        }
      }
    ]
  ]
}
